{
  "name": "car-expense-tracker",
  "version": "2.0.1",
  "author": "Ismael Marot <ismaelmarot@hotmail.com>",
  "description": "Car Expense Tracker App",
  "main": "electron.js",
  "scripts": {
    "frontend": "cd car-expense-tracker-frontend && npm start",
    "backend": "cd car-expense-tracker-backend && node server.js",
    "build-frontend": "cd car-expense-tracker-frontend && npm run build",
    "electron": "electron .",
    "package": "npm run build-frontend && npx electron-builder",
    "start": "concurrently \"npm run start:react\" \"npm run start:electron\"",
    "start:react": "cd car-expense-tracker-frontend && npm start",
    "start:electron": "wait-on http://localhost:3000 && electron .",
    "electron-build": "npm run build-frontend && npx electron-builder --mac --win --publish never",
    "electron-publish": "npm run build-frontend && npx electron-builder --mac --win --publish always"
  },
  "dependencies": {
    "concurrently": "^9.1.0",
    "express": "^4.18.2",
    "sqlite3": "^5.1.7",
    "cors": "^2.8.5",
    "pdfkit": "^0.14.0",
    "json2csv": "^6.0.0-alpha.2"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.car-expense-tracker",
    "productName": "CarET",
    "files": [
      "car-expense-tracker-frontend/build/**/*",
      "electron.js",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "app-icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "app-icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ismaelmarot",
        "repo": "car-expense-tracker"
      }
    ]
  },
  "license": "ISC"
}
